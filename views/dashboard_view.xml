<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_funeral_dashboard_form" model="ir.ui.view">
        <field name="name">funeral.dashboard.form</field>
        <field name="model">funeral.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <style>
                        .funeral-dashboard-container {
                            background: #f8fafc;
                            padding: 0.5rem 2rem 2rem 2rem;
                            font-family: 'Inter', -apple-system, sans-serif;
                            border-radius: 24px;
                        }
                        .f-header {
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                            margin-bottom: 2rem;
                        }
                        .f-header h1 {
                            font-size: 2rem;
                            font-weight: 800;
                            color: #0f172a;
                            margin: 0;
                        }
                        .f-upload-btn {
                            background: #3b82f6;
                            color: white;
                            padding: 10px 20px;
                            border-radius: 12px;
                            font-weight: 600;
                            border: none;
                            transition: all 0.3s ease;
                            display: flex;
                            align-items: center;
                            gap: 8px;
                            text-decoration: none;
                        }
                        .f-upload-btn:hover {
                            background: #2563eb;
                            transform: translateY(-2px);
                            box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.2);
                            color: white;
                        }
                        .f-card {
                            background: white;
                            border-radius: 20px;
                            padding: 1.5rem;
                            display: flex;
                            align-items: center;
                            justify-content: space-between;
                            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
                            border: 1px solid rgba(0,0,0,0.02);
                            transition: all 0.3s ease;
                            position: relative;
                            overflow: hidden;
                        }
                        .f-card:hover {
                            transform: translateY(-5px);
                            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
                        }
                        .f-card::after {
                            content: '';
                            position: absolute;
                            bottom: 0;
                            left: 0;
                            height: 5px;
                            width: 100%;
                        }
                        .c-primary::after { background: #3b82f6; }
                        .c-success::after { background: #10b981; }
                        .c-info::after { background: #06b6d4; }
                        .c-warning::after { background: #f59e0b; }
                        .c-danger::after { background: #ef4444; }
                        .c-secondary::after { background: #64748b; }
                        
                        .f-card-content {
                            display: flex;
                            flex-direction: column;
                        }
                        .f-card-title {
                            font-size: 0.9rem;
                            font-weight: 700;
                            color: #64748b;
                            text-transform: uppercase;
                            letter-spacing: 0.5px;
                        }
                        .f-card-value {
                            font-size: 2.2rem;
                            font-weight: 900;
                            color: #0f172a;
                            margin: 0;
                            line-height: 1.2;
                        }
                        .f-card-icon {
                            width: 54px;
                            height: 54px;
                            border-radius: 16px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 1.8rem;
                        }
                        .i-primary { background: #eff6ff; color: #3b82f6; }
                        .i-success { background: #ecfdf5; color: #10b981; }
                        .i-info { background: #ecfeff; color: #06b6d4; }
                        .i-warning { background: #fffbeb; color: #f59e0b; }
                        .i-danger { background: #fef2f2; color: #ef4444; }
                        .i-secondary { background: #f8fafc; color: #64748b; }
                    </style>
                    <div class="funeral-dashboard-container">
                        <div class="f-header">
                            <h1>Overview</h1>
                            <button name="action_open_import_wizard" type="object" class="f-upload-btn">
                                <i class="fa fa-upload"/> Upload CSV Plans
                            </button>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4 mb-4">
                                <div class="f-card c-primary">
                                    <div class="f-card-content">
                                        <span class="f-card-title">Agents</span>
                                        <span class="f-card-value"><field name="agent_count" nolabel="1"/></span>
                                    </div>
                                    <div class="f-card-icon i-primary"><i class="fa fa-users"/></div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="f-card c-success">
                                    <div class="f-card-content">
                                        <span class="f-card-title">Cities</span>
                                        <span class="f-card-value"><field name="city_count" nolabel="1"/></span>
                                    </div>
                                    <div class="f-card-icon i-success"><i class="fa fa-map-marker"/></div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="f-card c-info">
                                    <div class="f-card-content">
                                        <span class="f-card-title">Regions</span>
                                        <span class="f-card-value"><field name="region_count" nolabel="1"/></span>
                                    </div>
                                    <div class="f-card-icon i-info"><i class="fa fa-globe"/></div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="f-card c-warning">
                                    <div class="f-card-content">
                                        <span class="f-card-title">Branches</span>
                                        <span class="f-card-value"><field name="branch_count" nolabel="1"/></span>
                                    </div>
                                    <div class="f-card-icon i-warning"><i class="fa fa-building"/></div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="f-card c-danger">
                                    <div class="f-card-content">
                                        <span class="f-card-title">Products</span>
                                        <span class="f-card-value"><field name="product_count" nolabel="1"/></span>
                                    </div>
                                    <div class="f-card-icon i-danger"><i class="fa fa-cube"/></div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="f-card c-secondary">
                                    <div class="f-card-content">
                                        <span class="f-card-title">Admin Policies</span>
                                        <span class="f-card-value"><field name="policy_count" nolabel="1"/></span>
                                    </div>
                                    <div class="f-card-icon i-secondary"><i class="fa fa-file-text-o"/></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="funeral_dashboard_record" model="funeral.dashboard">
        <field name="name">Dashboard</field>
    </record>

    <record id="action_funeral_dashboard_window" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">funeral.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="funeral_assurance.funeral_dashboard_record"/>
        <field name="target">current</field>
    </record>

    <!-- Import Wizard View -->
    <record id="view_funeral_plan_import_wizard_form" model="ir.ui.view">
        <field name="name">funeral.plan.import.wizard.form</field>
        <field name="model">funeral.plan.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Plans CSV">
                <group>
                    <field name="csv_file" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button string="Import" name="action_import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
