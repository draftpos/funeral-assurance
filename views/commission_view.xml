<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_funeral_commission_form" model="ir.ui.view">
            <field name="name">funeral.commission.form</field>
            <field name="model">funeral.commission</field>
            <field name="arch" type="xml">
                <form string="Commission">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,paid,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="agent_id"/>
                                <field name="proposal_id"/>
                                <field name="payment_id"/>
                            </group>
                            <group>
                                <field name="amount"/>
                                <field name="commission_date"/>
                                <field name="type"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_funeral_commission_list" model="ir.ui.view">
            <field name="name">funeral.commission.list</field>
            <field name="model">funeral.commission</field>
            <field name="arch" type="xml">
                <list string="Commissions">
                    <field name="name" optional="show"/>
                    <field name="agent_id" optional="show"/>
                    <field name="proposal_id" optional="show"/>
                    <field name="amount" optional="show"/>
                    <field name="commission_date" optional="show"/>
                    <field name="type" optional="show"/>
                    <field name="state" optional="show" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="action_funeral_commission" model="ir.actions.act_window">
            <field name="name">Agent Commissions</field>
            <field name="res_model">funeral.commission</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_funeral_commission"
                  name="Commissions"
                  parent="menu_funeral_operations"
                  action="action_funeral_commission"
                  sequence="30"/>
                  
        <!-- Commission Run Batch Views -->
        <record id="view_funeral_commission_run_form" model="ir.ui.view">
            <field name="name">funeral.commission.run.form</field>
            <field name="model">funeral.commission.run</field>
            <field name="arch" type="xml">
                <form string="Commission Run">
                    <header>
                        <button name="action_run_commissions" string="Run Commission Engine" type="object" class="btn-primary" invisible="state == 'done'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="month"/>
                                <field name="year"/>
                            </group>
                            <group>
                                <field name="total_commission"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Commissions">
                                <field name="commission_ids" readonly="1">
                                    <list decoration-danger="type == 'penalty'" decoration-success="type == 'earned'">
                                        <field name="agent_id" widget="many2one_avatar_user"/>
                                        <field name="proposal_id"/>
                                        <field name="payment_id"/>
                                        <field name="type" widget="badge" decoration-danger="type == 'penalty'" decoration-success="type == 'earned'"/>
                                        <field name="amount" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="state" widget="badge" decoration-success="state == 'paid'" decoration-info="state == 'draft'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_funeral_commission_run_list" model="ir.ui.view">
            <field name="name">funeral.commission.run.list</field>
            <field name="model">funeral.commission.run</field>
            <field name="arch" type="xml">
                <list string="Commission Runs">
                    <field name="name"/>
                    <field name="month"/>
                    <field name="year"/>
                    <field name="total_commission"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>

        <record id="action_funeral_commission_run" model="ir.actions.act_window">
            <field name="name">Commission Runs</field>
            <field name="res_model">funeral.commission.run</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_funeral_commission_run"
                  name="Commission Engine Runs"
                  parent="menu_funeral_operations"
                  action="action_funeral_commission_run"
                  sequence="31"/>
    </data>
</odoo>
