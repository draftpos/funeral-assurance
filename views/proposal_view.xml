<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_funeral_proposal_form" model="ir.ui.view">
            <field name="name">funeral.proposal.form</field>
            <field name="model">funeral.proposal</field>
            <field name="arch" type="xml">
                <form string="Proposal">
                    <header>
                        <button name="action_accept_proposal" string="Accept Proposal" type="object" class="btn-success" invisible="state != 'Underwriting'"/>
                        <button name="action_create_payment" string="Make Payment" type="object" class="btn-primary" invisible="state not in ['Accepted', 'Active', 'Arrears', 'Lapsed']"/>
                        <button name="action_activate_policy" string="Activate Policy" type="object" class="btn-success" invisible="state != 'Accepted' or not has_payment"/>
                        <button name="action_activate_error" string="Activate Policy" type="object" class="btn-secondary" invisible="state != 'Accepted' or has_payment"/>
                        
                        <button name="action_force_lapse" string="Force Lapse (Test)" type="object" class="btn-secondary"/>
                        <button name="action_open_promo_wizard" string="Apply Promo Revive" type="object" class="btn-warning" invisible="state != 'Lapsed'"/>
                        <button name="action_print_proposal" string="Preview Pdf" type="object" class="btn-info"/>
                        <button name="action_download_user_policy" string="User Admin Policy Doc" type="object" class="btn-primary" invisible="state in ['Underwriting'] or not admin_policy_id"/>
                        
                        <field name="state" invisible="1"/>
                        <field name="status_id" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="proposal_date"/>
                            </group>
                            <group>
                                <field name="partner_id" invisible="partner_id == False"/>
                            </group>
                        </group>
                        <div class="row">
                            <div class="col-md-4">
                                <group string="Personal Details">
                                    <field name="title"/>
                                    <field name="first_name"/>
                                    <field name="last_name"/>
                                    <field name="national_id" placeholder="e.g. 63-1234567A89"/>
                                    <field name="is_override_id"/>
                                    <field name="dob"/>
                                    <field name="gender_id"/>
                                    <field name="marital_status"/>
                                    <field name="next_of_kin"/>
                                </group>
                            </div>
                            <div class="col-md-4">
                                <group string="Contact Details">
                                    <field name="home_phone"/>
                                    <field name="business_phone"/>
                                    <field name="email"/>
                                    <field name="residential_address"/>
                                    <field name="business_address"/>
                                </group>
                            </div>
                            <div class="col-md-4">
                                <group string="Employment Details">
                                    <field name="employer"/>
                                    <field name="occupation_id"/>
                                    <field name="ec_number"/>
                                    <field name="gross_salary"/>
                                    <field name="net_salary"/>
                                </group>
                            </div>
                        </div>
                        
                        <notebook>
                            <page string="Policy &amp; Underwriting Details">
                                <group>
                                    <group string="Policy Cover Details">
                                        <field name="product_id"/>
                                        <field name="has_sub_plans" invisible="1"/>
                                        <field name="product_rate_id" domain="[('product_id', '=', product_id)]" options="{'no_create': True}" invisible="not has_sub_plans"/>
                                        <field name="structural_type_id"/>
                                        <field name="is_policy_state" invisible="1"/>
                                        <field name="allow_dependants" invisible="1"/>
                                        <field name="allow_extended_family" invisible="1"/>
                                        <field name="premium_amount"/>
                                        <field name="total_premium" readonly="1"/>
                                        <field name="sum_assured"/>
                                        <field name="grocery_benefit" readonly="1" force_save="1"/>
                                        <field name="casket_allocation" readonly="1" force_save="1"/>
                                        <field name="policy_term"/>
                                        <field name="waiting_period"/>
                                    </group>
                                     <group string="Agent &amp; Payment Setup">
                                        <field name="agent_id"/>
                                        <field name="branch_id" readonly="1" force_save="1"/>
                                        <field name="mode_of_payment"/>
                                        <field name="frequency"/>
                                        <field name="first_payment_date"/>
                                        <field name="admin_policy_id" options="{'no_create': True}"/>
                                    </group>
                                </group>

                                <group string="Underwriting &amp; Declaration">
                                    <field name="underwriting_decision"/>
                                </group>
                                <group string="Policy Status &amp; Tracking" invisible="not is_policy_state">
                                    <field name="paid_up_to"/>
                                    <field name="is_in_arrears"/>
                                    <field name="months_in_arrears" invisible="is_in_arrears == False" style="color: red; font-weight: bold;"/>
                                    <field name="arrears_amount" invisible="is_in_arrears == False" style="color: red; font-weight: bold;"/>
                                    <field name="months_paid_to_agent" readonly="1"/>
                                    <field name="commencement_date" readonly="1"/>
                                    <field name="policy_document"/>
                                    <field name="cancellation_reason"/>
                                </group>
                            </page>
                            <page string="User Admin Policy" invisible="state in ['Underwriting']">
                                <group>
                                    <group string="Company Policy Document">
                                        <field name="admin_policy_id" readonly="state not in ['Underwriting', 'Accepted']"/>
                                        <field name="admin_policy_filename" invisible="1"/>
                                        <field name="admin_policy_description" invisible="1"/>
                                    </group>
                                </group>
                                <group string="Policy Terms &amp; Summary">
                                    <field name="admin_policy_description" readonly="1" placeholder="Selected policy summary will appear here..."/>
                                </group>
                            </page>
                            <page string="Beneficiaries / Dependants" invisible="not allow_dependants">
                                <field name="dependant_ids">
                                    <list editable="bottom">
                                        <field name="last_name" optional="show"/>
                                        <field name="first_name" optional="show"/>
                                        <field name="relationship" optional="show"/>
                                        <field name="dob" optional="show"/>
                                        <field name="national_id" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Extended Families" invisible="not allow_extended_family">
                                <field name="extended_family_ids">
                                    <list editable="bottom">
                                        <field name="last_name" optional="show"/>
                                        <field name="first_name" optional="show"/>
                                        <field name="relationship_id" optional="show"/>
                                        <field name="dob" optional="show"/>
                                        <field name="age" optional="show"/>
                                        <field name="national_id" optional="show"/>
                                        <field name="extended_premium_amount" optional="show"/>
                                        <field name="has_college_proof" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Benefits">
                                <field name="benefit_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="benefit_type"/>
                                        <field name="premium_amount" invisible="benefit_type == 'mandatory'"/>
                                        <field name="beneficial_amount" invisible="benefit_type == 'mandatory'"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_funeral_proposal_tree" model="ir.ui.view">
            <field name="name">funeral.proposal.tree</field>
            <field name="model">funeral.proposal</field>
            <field name="arch" type="xml">
                <list string="Proposals">
                    <field name="name" optional="show"/>
                    <field name="proposal_date" optional="hide"/>
                    <field name="title" optional="hide"/>
                    <field name="first_name" optional="hide"/>
                    <field name="last_name" optional="hide"/>
                    <field name="full_name" optional="show"/>
                    <field name="national_id" optional="show"/>
                    <field name="home_phone" optional="show"/>
                    <field name="email" optional="hide"/>
                    <field name="product_id" optional="hide"/>
                    <field name="structural_type_id" optional="show"/>
                    <field name="premium_amount" optional="show"/>
                    <field name="sum_assured" optional="hide"/>
                    <field name="agent_id" optional="hide"/>
                    <field name="branch_id" optional="hide"/>
                    <field name="status_id" optional="show" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_funeral_proposal_search" model="ir.ui.view">
            <field name="name">funeral.proposal.search</field>
            <field name="model">funeral.proposal</field>
            <field name="arch" type="xml">
                <search string="Search Proposals">
                    <field name="name"/>
                    <field name="full_name"/>
                    <field name="national_id"/>
                    <field name="home_phone"/>
                    <field name="structural_type_id"/>
                    <field name="status_id"/>
                    <field name="agent_id"/>
                    <field name="branch_id"/>
                    
                    <separator/>
                    <filter string="Active Policies" name="filter_active" domain="[('state', 'ilike', 'Active')]"/>
                    <filter string="Lapsed Policies" name="filter_lapsed" domain="[('state', 'ilike', 'Lapse')]"/>
                    <filter string="In Arrears" name="filter_arrears" domain="[('state', 'ilike', 'Arrears')]"/>
                    <filter string="Underwriting" name="filter_underwriting" domain="[('state', 'ilike', 'Underwriting')]"/>
                    <filter string="Accepted" name="filter_accepted" domain="[('state', 'ilike', 'Accepted')]"/>
                    
                    <separator/>
                    <filter string="Proposal Date" name="filter_proposal_date" date="proposal_date"/>
                    <filter string="Commencement Date" name="filter_commencement_date" date="commencement_date"/>
                    <filter string="Creation Date" name="filter_create_date" date="create_date"/>
                    
                    <separator/>
                    <filter string="Group By Status" name="group_status" context="{'group_by': 'status_id'}"/>
                    <filter string="Group By Agent" name="group_agent" context="{'group_by': 'agent_id'}"/>
                    <filter string="Group By Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Group By Proposal Month" name="group_proposal_month" context="{'group_by': 'proposal_date:month'}"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_funeral_proposal" model="ir.actions.act_window">
            <field name="name">Proposals</field>
            <field name="res_model">funeral.proposal</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_funeral_proposal_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Proposal
                </p>
            </field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_funeral_proposal"
                  name="Proposals"
                  parent="menu_funeral_operations"
                  action="action_funeral_proposal"
                  sequence="2"/>
                  
        <!-- Action for Active Policies -->
        <record id="action_funeral_active_policies" model="ir.actions.act_window">
            <field name="name">All Policies</field>
            <field name="res_model">funeral.proposal</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <!-- Menu Item for Active Policies -->
        <menuitem id="menu_funeral_active_policies"
                  name="View Policies"
                  parent="menu_funeral_root"
                  action="action_funeral_active_policies"
                  sequence="35"/>
    </data>
</odoo>
